   "source": [
    "# 0. 准备工作：导入依赖 + 关闭 SSL 警告\n",
    "import urllib3\n",
    "urllib3.disable_warnings()\n",
    "\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "from urllib.parse import urljoin\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "BASE_URL = \"https://115.159.159.82\"\n",
    "session = requests.Session()\n",
    "session.verify = False\n",
    "print(\"环境就绪\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "48a637a3",
   "metadata": {},
   "source": [
    "# 任务 1：判断数据加载方式\n",
    "\n",
    "## 1.1 Device：动态加载 → API\n",
    "\n",
    "`/devices` 页面初始 HTML 不含设备数据，只显示\"正在读取设备数据…\"，需要通过 API 动态加载。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8c11880a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:26.689261Z",
     "iopub.status.busy": "2026-10-10T07:57:26.689070Z",
     "iopub.status.idle": "2026-10-10T07:57:26.961777Z",
     "shell.execute_reply": "2026-10-10T07:57:26.961106Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "初始 HTML 长度: 2949\n",
      "tbody 内文本: 正在加载…\n"
     ]
    }
   ],
   "source": [
    "# 查看 /devices 静态 HTML 的关键片段\n",
    "r = session.get(f\"{BASE_URL}/devices\", timeout=10)\n",
    "soup = BeautifulSoup(r.text, \"html.parser\")\n",
    "# 初始 HTML 中是否含设备名？\n",
    "print(\"初始 HTML 长度:\", len(r.text))\n",
    "print(\"tbody 内文本:\", soup.select_one(\"tbody\").get_text(\" | \", strip=True)[:200])\n",
    "# 结论：设备数据不在初始 HTML 中 → 动态加载 → 查 API\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6bb8baab",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:26.963307Z",
     "iopub.status.busy": "2026-10-10T07:57:26.963088Z",
     "iopub.status.idle": "2026-10-10T07:57:27.094767Z",
     "shell.execute_reply": "2026-10-10T07:57:27.094088Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "status: 200\n",
      "url: https://115.159.159.82/api/devices?page=1&page_size=50\n",
