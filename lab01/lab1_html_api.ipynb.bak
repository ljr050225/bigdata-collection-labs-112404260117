      "first item: {'device_id': 'D00000001', 'company_id': 'C000001', 'device_name': '循环泵-000001-001', 'device_type': 'pump', 'model': 'SP-PUM-800', 'zone': '智造一区', 'install_date': '2021-09-19', 'rated_power_kw': 71.2, 'sampling_interval_s': 30, 'protocol': 'mqtt', 'status': 'running', 'updated_at': '2026-09-01T03:58:00'}\n"
     ]
    }
   ],
   "source": [
    "# 验证 API：/api/devices\n",
    "api_url = f\"{BASE_URL}/api/devices\"\n",
    "r = session.get(api_url, params={\"page\": 1, \"page_size\": 50}, timeout=10)\n",
    "print(\"status:\", r.status_code)\n",
    "print(\"url:\", r.url)\n",
    "print(\"content-type:\", r.headers.get(\"Content-Type\"))\n",
    "data = r.json()\n",
    "print(\"type:\", type(data).__name__)\n",
    "print(\"keys:\", list(data.keys()))\n",
    "print(\"total:\", data[\"total\"])\n",
    "print(\"page:\", data[\"page\"])\n",
    "print(\"page_size:\", data[\"page_size\"])\n",
    "print(\"first item keys:\", list(data[\"items\"][0].keys()))\n",
    "print(\"first item:\", data[\"items\"][0])\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3938f067",
   "metadata": {},
   "source": [
    "## 1.2 Company：静态加载 → HTML\n",
    "\n",
    "`/companies` 的初始 HTML 中已包含企业数据，可以直接请求并解析。"
