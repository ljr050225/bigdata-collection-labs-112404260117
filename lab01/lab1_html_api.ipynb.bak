     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  page 60/100, got 50 items\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  page 70/100, got 50 items\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  page 80/100, got 50 items\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  page 90/100, got 50 items\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  page 100/100, got 50 items\n",
      "[done] 采集完成，耗时 7.7s\n",
      "device count: 5000\n",
      "unique device_id: 5000\n"
     ]
    }
   ],
   "source": [
    "# 2.2 完整分页采集所有设备\n",
    "import time\n",
    "\n",
    "devices = []\n",
    "t0 = time.time()\n",
    "for page in range(1, total_pages + 1):\n",
    "    r = session.get(\n",
    "        api_url,\n",
    "        params={\"page\": page, \"page_size\": page_size},\n",
    "        timeout=10,\n",
    "    )\n",
    "    page_data = r.json()\n",
    "    page_items = page_data[\"items\"]\n",
    "    devices.extend(page_items)\n",
    "    if page % 10 == 0 or page == 1:\n",
    "        print(f\"  page {page}/{total_pages}, got {len(page_items)} items\")\n",
    "\n",
    "print(f\"[done] 采集完成，耗时 {time.time()-t0:.1f}s\")\n",
    "print(\"device count:\", len(devices))\n",
    "print(\"unique device_id:\", len(set(d[\"device_id\"] for d in devices)))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bca06af3",
   "metadata": {},
   "source": [
    "# 任务 3：Company HTML 解析（第一页）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "59664900",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:34.902907Z",
     "iopub.status.busy": "2026-10-10T07:57:34.902575Z",
     "iopub.status.idle": "2026-10-10T07:57:34.972666Z",
     "shell.execute_reply": "2026-10-10T07:57:34.971995Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "本页企业数: 20\n"
     ]
    }
   ],
   "source": [
    "# 3.1 设计 selector 并验证\n",
    "current_url = f\"{BASE_URL}/companies\"\n",
    "soup = BeautifulSoup(session.get(current_url, timeout=10).text, \"html.parser\")\n",
    "\n",
    "# 企业记录 selector: article.company-card (带 data-company-id 属性)\n",
    "cards = soup.select(\"article.company-card\")\n",
    "print(\"本页企业数:\", len(cards))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "e7042317",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:34.974057Z",
     "iopub.status.busy": "2026-10-10T07:57:34.973880Z",
     "iopub.status.idle": "2026-10-10T07:57:34.978157Z",
     "shell.execute_reply": "2026-10-10T07:57:34.977503Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "第一条企业: {'company_id': 'C000001', 'name': '临港精工001有限公司', 'industry': '汽车零部件', 'zone': '智造一区', 'device_count': 6, 'status': '运营中'}\n"
     ]
    }
   ],
   "source": [
    "# 3.2 提取一条企业的完整字段\n",
    "import re\n",
    "\n",
    "def parse_company_card(card):\n",
    "    company_id = card.get(\"data-company-id\")\n",
    "    name = card.select_one(\"h2 a\").get_text(strip=True)\n",
    "    status = card.select_one(\".badge\").get_text(strip=True)\n",
    "\n",
    "    details = {}\n",
    "    for item in card.select(\"dl > div\"):\n",
    "        key = item.select_one(\"dt\").get_text(strip=True)\n",
    "        value = item.select_one(\"dd\").get_text(strip=True)\n",
    "        details[key] = value\n",
    "\n",
    "    industry = details.get(\"所属行业\", \"\")\n",
    "    zone = details.get(\"所在区域\", \"\")\n",
    "    device_count = int(re.search(r\"\\d+\", details.get(\"设备数量\", \"0\")).group())\n",
    "\n",
    "    return {\n",
    "        \"company_id\": company_id,\n",
    "        \"name\": name,\n",
    "        \"industry\": industry,\n",
    "        \"zone\": zone,\n",
    "        \"device_count\": device_count,\n",
    "        \"status\": status,\n",
    "    }\n",
    "\n",
    "card = cards[0]\n",
    "first_company = parse_company_card(card)\n",
    "print(\"第一条企业:\", first_company)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "d8b06d1c",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:34.979862Z",
     "iopub.status.busy": "2026-10-10T07:57:34.979662Z",
     "iopub.status.idle": "2026-10-10T07:57:34.996426Z",
     "shell.execute_reply": "2026-10-10T07:57:34.994692Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "本页企业数: 20\n",
      "示例 3 条:\n",
      "  {'company_id': 'C000001', 'name': '临港精工001有限公司', 'industry': '汽车零部件', 'zone': '智造一区', 'device_count': 6, 'status': '运营中'}\n",
      "  {'company_id': 'C000002', 'name': '临港装备002有限公司', 'industry': '精密电子', 'zone': '智造二区', 'device_count': 26, 'status': '运营中'}\n",
      "  {'company_id': 'C000003', 'name': '临港动力003有限公司', 'industry': '精密电子', 'zone': '智造一区', 'device_count': 6, 'status': '运营中'}\n"
     ]
    }
   ],
   "source": [
    "# 3.3 解析本页 20 条企业\n",
    "companies_page1 = [parse_company_card(c) for c in cards]\n",
    "print(\"本页企业数:\", len(companies_page1))\n",
    "print(\"示例 3 条:\")\n",
    "for c in companies_page1[:3]:\n",
    "    print(\" \", c)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "578c1b13",
   "metadata": {},
   "source": [
    "# 任务 4：Company \"下一页\"分页采集 3 页"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5170fe71",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:34.999722Z",
     "iopub.status.busy": "2026-10-10T07:57:34.999357Z",
     "iopub.status.idle": "2026-10-10T07:57:35.009580Z",
     "shell.execute_reply": "2026-10-10T07:57:35.005963Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "所有分页链接: [('下一页', '/companies?page=2')]\n",
      "[next-page] selector 命中: True\n",
      "text: 下一页\n",
      "href: /companies?page=2\n",
      "absolute: https://115.159.159.82/companies?page=2\n"
     ]
    }
   ],
   "source": [
    "# 4.1 验证\"下一页\"链接\n",
    "# 关键陷阱：nav.pagination 第一个 <a> 可能是\"上一页\"\n",
    "# 必须按文本精确匹配 \"下一页\"\n",
    "all_links = soup.select(\"nav.pagination a\")\n",
    "print(\"所有分页链接:\", [(a.get_text(strip=True), a.get(\"href\")) for a in all_links])\n",
    "\n",
    "next_link = next((a for a in all_links if a.get_text(strip=True) == \"下一页\"), None)\n",
    "print(\"[next-page] selector 命中:\", next_link is not None)\n",
    "if next_link:\n",
    "    print(\"text:\", next_link.get_text(strip=True))\n",
    "    print(\"href:\", next_link.get(\"href\"))\n",
    "    next_url = urljoin(current_url, next_link.get(\"href\"))\n",
    "    print(\"absolute:\", next_url)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "da1c17c3",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:35.012568Z",
     "iopub.status.busy": "2026-10-10T07:57:35.012256Z",
     "iopub.status.idle": "2026-10-10T07:57:35.364561Z",
     "shell.execute_reply": "2026-10-10T07:57:35.363522Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "第 1 页: https://115.159.159.82/companies  →  20 条\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "第 2 页: https://115.159.159.82/companies?page=2  →  20 条\n",
      "第 3 页: https://115.159.159.82/companies?page=3  →  20 条\n",
      "[summary] Company 总数: 60\n",
      "唯一 company_id: 60\n"
     ]
    }
   ],
   "source": [
    "# 4.2 三页连续采集\n",
    "companies = []\n",
    "current_url = f\"{BASE_URL}/companies\"\n",
    "\n",
    "for page_idx in range(3):\n",
    "    if page_idx == 0:\n",
    "        url = current_url\n",
    "    else:\n",
    "        # 用当前页的 soup 重新找\"下一页\"\n",
    "        next_link = next(\n",
    "            (a for a in soup.select(\"nav.pagination a\")\n",
    "             if a.get_text(strip=True) == \"下一页\"),\n",
    "            None\n",
    "        )\n",
    "        if next_link is None:\n",
    "            print(f\"第 {page_idx+1} 页已无下一页，停止\")\n",
    "            break\n",
    "        url = urljoin(current_url, next_link.get(\"href\"))\n",
    "\n",
    "    r = session.get(url, timeout=10)\n",
    "    soup = BeautifulSoup(r.text, \"html.parser\")\n",
    "    cards = soup.select(\"article.company-card\")\n",
    "    page_companies = [parse_company_card(c) for c in cards]\n",
    "    companies.extend(page_companies)\n",
    "    print(f\"第 {page_idx+1} 页: {url}  →  {len(page_companies)} 条\")\n",
    "\n",
    "print(f\"[summary] Company 总数: {len(companies)}\")\n",
    "print(f\"唯一 company_id: {len(set(c['company_id'] for c in companies))}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1af5412a",
   "metadata": {},
   "source": [
    "# 任务 5：结果验证"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "ee380bd1",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:35.366635Z",
     "iopub.status.busy": "2026-10-10T07:57:35.366431Z",
     "iopub.status.idle": "2026-10-10T07:57:35.370811Z",
     "shell.execute_reply": "2026-10-10T07:57:35.369936Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Company 总数: 60\n",
      "唯一 company_id: 60\n",
      "Device 总数: 5000\n",
      "唯一 device_id: 5000\n"
     ]
    }
   ],
   "source": [
    "# 5.1 数量与 ID 唯一性\n",
    "companies_n = len(companies)\n",
    "companies_unique = len(set(c[\"company_id\"] for c in companies))\n",
    "\n",
    "devices_n = len(devices)\n",
    "devices_unique = len(set(d[\"device_id\"] for d in devices))\n",
    "\n",
    "print(f\"Company 总数: {companies_n}\")\n",
    "print(f\"唯一 company_id: {companies_unique}\")\n",
    "print(f\"Device 总数: {devices_n}\")\n",
    "print(f\"唯一 device_id: {devices_unique}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "f81705ce",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:35.372105Z",
     "iopub.status.busy": "2026-10-10T07:57:35.371921Z",
     "iopub.status.idle": "2026-10-10T07:57:35.376570Z",
     "shell.execute_reply": "2026-10-10T07:57:35.376042Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Company–Device 不一致企业数: 0\n"
     ]
    }
   ],
   "source": [
    "# 5.2 Company–Device 一致性\n",
    "device_counts = Counter(d[\"company_id\"] for d in devices)\n",
    "\n",
    "mismatch_count = 0\n",
    "mismatches = []\n",
    "for company in companies:\n",
    "    cid = company[\"company_id\"]\n",
    "    expected = company[\"device_count\"]\n",
    "    actual = device_counts.get(cid, 0)\n",
    "    if expected != actual:\n",
    "        mismatch_count += 1\n",
    "        if len(mismatches) < 5:\n",
    "            mismatches.append((cid, company[\"name\"], expected, actual))\n",
    "\n",
    "print(f\"Company–Device 不一致企业数: {mismatch_count}\")\n",
    "if mismatches:\n",
    "    print(\"示例不一致:\")\n",
    "    for m in mismatches:\n",
    "        print(\" \", m)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4a3a57a2",
   "metadata": {},
   "source": [
    "# 任务 6：保存采集结果"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "30d708d1",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T07:57:35.378088Z",
     "iopub.status.busy": "2026-10-10T07:57:35.377887Z",
     "iopub.status.idle": "2026-10-10T07:57:35.451497Z",
     "shell.execute_reply": "2026-10-10T07:57:35.450518Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "已保存:\n",
      "  data\\devices.json\n",
      "  data\\companies.json\n",
      "  devices.json 条数: 5000\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  companies.json 条数: 60\n"
     ]
    }
   ],
   "source": [
    "# 6.1 保存 JSON\n",
    "data_dir = Path(\"data\")\n",
    "data_dir.mkdir(exist_ok=True)\n",
    "\n",
    "with open(data_dir / \"devices.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(devices, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "with open(data_dir / \"companies.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(companies, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "print(\"已保存:\")\n",
    "print(\" \", data_dir / \"devices.json\")\n",
    "print(\" \", data_dir / \"companies.json\")\n",
    "print(\"  devices.json 条数:\", len(json.load(open(data_dir/\"devices.json\", encoding=\"utf-8\"))))\n",
    "print(\"  companies.json 条数:\", len(json.load(open(data_dir/\"companies.json\", encoding=\"utf-8\"))))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ff4d7aae",
   "metadata": {},
   "source": [
    "# 自检清单\n",
    "\n",
    "```text\n",
    "□ 会用\"查看网页源代码\"判断静态 / 动态加载\n",
    "□ 能在 Network 中找到 Device API\n",
    "□ 能读懂 API 分页结构并自动计算总页数\n",
    "□ Device 共采集 5000 条，device_id 无重复\n",
    "□ 能设计简洁、稳定的 Company CSS Selector\n",
    "□ 能定位\"下一页\"并读取 href\n",
    "□ Company 连续采集 3 页，共 60 条\n",
    "□ company_id 无重复\n",
    "□ Company–Device 数量检查通过\n",
    "□ 已保存 companies.json 和 devices.json\n",
    "```\n"
   ]
  }
